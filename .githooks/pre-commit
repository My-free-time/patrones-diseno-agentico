#!/bin/sh
set -eu
node scripts/check-files.mjs --staged
node scripts/validate-course.mjs
if command -v gitleaks >/dev/null 2>&1; then
  scanner=gitleaks
elif [ -x .local-tools/gitleaks ]; then
  scanner=.local-tools/gitleaks
else
  echo "Instala Gitleaks para revisar los cambios antes de confirmar." >&2
  exit 1
fi
"$scanner" git --staged --redact --no-banner --ignore-gitleaks-allow
